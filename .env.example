# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/hylist

# Auth secrets (generate strong random strings, e.g. `openssl rand -hex 32`)
AUTH_JWT_SECRET=change-me-to-a-long-random-secret
AUTH_REFRESH_PEPPER=change-me-to-a-different-long-random-secret

# Public URL of the site (used for links in Discord notifications; localhost links are skipped)
SITE_URL=http://localhost:3000

# Optional: Discord channel webhook – posts a message when a new server is added
# Discord → Channel settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Set to false only if you open the production build over plain http (e.g. http://192.168.x.x:3000).
# Behind HTTPS leave it empty.
COOKIE_SECURE=

# Dev-only helper: first registered user becomes admin (ignored when NODE_ENV=production)
ALLOW_ADMIN_SIGNUP=true
