generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  vip
  admin
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @default("") @map("display_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.LongText
  role         Role      @default(user)
  vipUntil     DateTime? @map("vip_until")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSignInAt DateTime? @map("last_sign_in_at")

  sessions     Session[]
  servers      Server[]  @relation("ServersCreatedBy")
  votes        Vote[]
  reports      Report[]
  reviews      Review[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Server {
  id                String    @id @default(uuid()) @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at")

  name              String    @db.VarChar(56)
  host              String    @db.VarChar(255)
  port              Int

  country           String    @default("Unknown") @db.VarChar(64)
  tagsJson          String    @default("[]") @map("tags_json") @db.VarChar(1024)

  description       String?   @db.LongText

  isFeatured        Boolean   @default(false) @map("is_featured")

  logoUrl           String?   @map("logo_url") @db.LongText
  bannerUrl         String?   @map("banner_url") @db.LongText

  verificationToken String    @map("verification_token") @db.VarChar(64)

  createdByUserId   String?   @map("created_by_user_id") @db.Char(36)
  createdByUser     User?     @relation("ServersCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastSeenAt        DateTime? @map("last_seen_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  heartbeatPlayers  Int?      @map("heartbeat_players")
  heartbeatCapacity Int?      @map("heartbeat_capacity")

  discordUrl        String?   @map("discord_url") @db.VarChar(255)
  websiteUrl        String?   @map("website_url") @db.VarChar(255)
  storeUrl          String?   @map("store_url") @db.VarChar(255)
  youtubeUrl        String?   @map("youtube_url") @db.VarChar(255)
  tiktokUrl         String?   @map("tiktok_url") @db.VarChar(255)
  twitterUrl        String?   @map("twitter_url") @db.VarChar(255)
  instagramUrl      String?   @map("instagram_url") @db.VarChar(255)
  voteWebhookUrl    String?   @map("vote_webhook_url") @db.VarChar(255)
  verifiedAt        DateTime? @map("verified_at")

  votes             Vote[]
  samples           ServerSample[]
  views             ServerView[]
  reports           Report[]
  reviews           Review[]

  @@unique([host, port])
  @@index([createdAt(sort: Desc)])
  @@index([createdByUserId])
  @@index([isFeatured, createdAt(sort: Desc)])
  @@map("servers")
}
model Vote {
  id        String   @id @default(uuid()) @db.Char(36)
  serverId  String   @map("server_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  ipHash    String   @map("ip_hash") @db.VarChar(64)
  playerName String? @map("player_name") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@index([userId, serverId, createdAt])
  @@index([ipHash, serverId, createdAt])
  @@map("votes")
}

model ServerSample {
  id       BigInt   @id @default(autoincrement())
  serverId String   @map("server_id") @db.Char(36)
  at       DateTime @default(now())
  online   Boolean
  players  Int?

  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at])
  @@index([at])
  @@map("server_samples")
}

model ServerView {
  serverId String   @map("server_id") @db.Char(36)
  day      DateTime @db.Date
  views    Int      @default(0)

  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, day])
  @@map("server_views")
}

model Report {
  id         String    @id @default(uuid()) @db.Char(36)
  serverId   String    @map("server_id") @db.Char(36)
  userId     String?   @map("user_id") @db.Char(36)
  reason     String    @db.VarChar(32)
  details    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolution String?   @db.VarChar(16)

  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
  @@index([serverId])
  @@map("reports")
}

model Review {
  id        String   @id @default(uuid()) @db.Char(36)
  serverId  String   @map("server_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  rating    Int      @db.TinyInt
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId, createdAt])
  @@index([userId])
  @@map("reviews")
}
